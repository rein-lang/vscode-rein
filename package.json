{
  "name": "rein",
  "displayName": "Rein",
  "description": "Language support for Rein, a small language for agent decision flows.",
  "version": "0.1.0",
  "publisher": "tupe12334",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rein-lang/vscode-rein"
  },
  "bugs": {
    "url": "https://github.com/rein-lang/vscode-rein/issues"
  },
  "homepage": "https://github.com/rein-lang/vscode-rein#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:rein",
    "onDebugResolve:rein",
    "onCommand:rein.debugProgram",
    "onCommand:rein.runProgram"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rein",
        "aliases": [
          "Rein"
        ],
        "extensions": [
          ".rein"
        ],
        "filenamePatterns": [
          "**/*.rein"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.rein": "rein"
      }
    },
    "grammars": [
      {
        "language": "rein",
        "scopeName": "source.rein",
        "path": "./syntaxes/rein.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rein",
        "path": "./snippets/rein.json"
      }
    ],
    "breakpoints": [
      {
        "language": "rein"
      }
    ],
    "debuggers": [
      {
        "type": "rein",
        "label": "Rein",
        "languages": [
          "rein"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .rein file to run, or a program name (see `rein list`)."
              },
              "entry": {
                "type": "string",
                "description": "Function to start from, as its path under the root without .rein. Default: main."
              },
              "inputs": {
                "type": "object",
                "description": "Values of the entry's string parameters, by name. A missing one is asked.",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "answers": {
                "type": "object",
                "description": "Answers given up front, by key such as merge.ci. Each other question is asked.",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop before the first question."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "rein",
            "request": "launch",
            "name": "Debug Rein Program",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Rein: Debug a program",
            "description": "Run a .rein program in the debugger. Questions are asked in VS Code.",
            "body": {
              "type": "rein",
              "request": "launch",
              "name": "Debug Rein Program",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rein.restartServer",
        "title": "Rein: Restart Language Server"
      },
      {
        "command": "rein.debugProgram",
        "title": "Rein: Debug Program",
        "icon": "$(play)"
      },
      {
        "command": "rein.runProgram",
        "title": "Rein: Run Program"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rein.debugProgram",
          "when": "resourceLangId == rein",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Rein",
      "properties": {
        "rein.serverPath": {
          "type": "string",
          "default": "rein",
          "description": "Path to the rein binary; it is started as `<path> lsp`, and `<path> dap` to debug."
        },
        "rein.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the rein language server."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "test": "node scripts/test-find-server.js && node scripts/test-grammar.js && node scripts/test-ask.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "packageManager": "pnpm@12.4.1"
}
