{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rein",
  "scopeName": "source.rein",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#input-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#references" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.rein",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.rein",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.rein",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },
    "input-declaration": {
      "match": "\\b(input)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.rein" },
        "2": { "name": "variable.other.declaration" }
      }
    },
    "keywords": {
      "name": "keyword.control.rein",
      "match": "\\b(?:description|input|if|else|switch|case|default|return)\\b"
    },
    "types": {
      "name": "storage.type.rein",
      "match": "\\b(?:bool|choice)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.rein",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.rein",
          "match": "==|!="
        }
      ]
    },
    "references": {
      "name": "entity.name.function.rein",
      "match": "@[A-Za-z_][A-Za-z0-9_-]*(?:/[A-Za-z_][A-Za-z0-9_-]*)*"
    }
  }
}
