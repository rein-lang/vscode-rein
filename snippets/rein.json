{
  "Decision function": {
    "prefix": "fn",
    "description": "Rein function: doc comment, one doc comment per parameter, and a return on every path",
    "body": [
      "/**",
      " * ${1:What this function decides.}",
      " */",
      "export default function ${2:name}(",
      "  /** ${3:Question for the user?} */",
      "  ${4:flag}: ${5:boolean},",
      ") {",
      "  if (${4:flag}) {",
      "    return \"${6:approved}\";",
      "  }",
      "",
      "  return \"${7:wait}\";",
      "}",
      "$0"
    ]
  },
  "Import": {
    "prefix": "import",
    "description": "Import another function in this project. Return it by its name.",
    "body": [
      "import ${1:nextStep} from \"${2:./next_step}\";$0"
    ]
  },
  "If statement": {
    "prefix": "if",
    "description": "if block with return",
    "body": [
      "if (${1:condition}) {",
      "  return \"${2:result}\";",
      "}$0"
    ]
  },
  "Switch statement": {
    "prefix": "switch",
    "description": "switch on a union parameter with cases and default",
    "body": [
      "switch (${1:name}) {",
      "  case \"${2:value}\":",
      "    return \"${3:result}\";",
      "  default:",
      "    return \"${4:result}\";",
      "}$0"
    ]
  },
  "Parameter": {
    "prefix": "param",
    "description": "Parameter with its own doc comment: a boolean or a union of strings",
    "body": [
      "/** ${1:Question for the user?} */",
      "${2:name}: ${3:boolean},$0"
    ]
  }
}
